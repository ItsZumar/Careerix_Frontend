{
  "expo": {
    "name": "careerix-frontend",
    "slug": "careerix-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "careerixfrontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.careerix.frontend",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "fonts": [
      "./assets/fonts/Mulish-Regular.ttf",
      "./assets/fonts/Mulish-Medium.ttf",
      "./assets/fonts/Mulish-Bold.ttf",
      "./assets/fonts/Mulish-SemiBold.ttf",
      "./assets/fonts/Mulish-Light.ttf",
      "./assets/fonts/Mulish-ExtraLight.ttf",
      "./assets/fonts/Mulish-ExtraBold.ttf",
      "./assets/fonts/Mulish-Black.ttf"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
